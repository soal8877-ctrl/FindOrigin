# Telegram Bot API (создайте бота через @BotFather)
TELEGRAM_BOT_TOKEN=

# Опционально: секрет для заголовка X-Telegram-Bot-Api-Secret-Token при setWebhook
TELEGRAM_WEBHOOK_SECRET=

# OpenRouter — сравнение смысла (модель openrouter/free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_SITE_URL=https://ваш-домен.vercel.app

# Google Custom Search JSON API + ID Programmable Search Engine (cx)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
